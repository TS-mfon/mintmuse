# ---- X Layer (creator coins + handle registry) ----
# X Layer mainnet RPC (change to testrpc.xlayer.tech for testnet)
NEXT_PUBLIC_XLAYER_RPC=https://rpc.xlayer.tech
NEXT_PUBLIC_XLAYER_CHAIN_ID=195
NEXT_PUBLIC_XLAYER_EXPLORER=https://explorer.xlayer.tech

# Deployed contract addresses — TESTNET (chain 1952):
#   UsernameRegistry  : 0x12A87EFA5721AeEd4F450120041547182368eCe3
#   CreatorCoinFactory: 0x4664edf2F8a8FAaBE63235132aBCAF9bCF88e164
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=

# ---- GenLayer (AI brain, StudioNet only) ----
GENLAYER_RPC=https://studio.genlayer.com/api
GENLAYER_CHAIN_ID=61999
# Set to "true" once the CreatorMuse contract is live on StudioNet.
# While false, the app uses the free Pollinations fallback so it stays fully functional.
GENLAYER_ENABLED=false
# CreatorMuse deployed on StudioNet:
#   0xa5F05f37E5BE1eb4214C9C22704E64E62f2bF963  (tx 0x5538336c…608f3fced)
GENLAYER_CONTRACT_ADDRESS=0xBAaacC8E34e80dD07F1c6bD9B1419BfAA35D37f9
NEXT_PUBLIC_GENLAYER_CONTRACT_ADDRESS=0xBAaacC8E34e80dD07F1c6bD9B1419BfAA35D37f9
# Optional: server-side GenLayer wallet (from StudioNet faucet) to write via the contract.
GENLAYER_PRIVATE_KEY=

# ---- Free AI (no API key required) ----
POLLINATIONS_TEXT_MODEL=openai-large
POLLINATIONS_IMAGE_MODEL=flux
